# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()
GET     /home                       controllers.HomeController.home()


# Auth routes
GET     /auth/sign-up               controllers.SignUpController.get()
POST    /auth/sign-up               controllers.SignUpController.submit()

GET     /auth/log-in                controllers.LogInController.get()
POST    /auth/log-in                controllers.LogInController.submit()

GET    /auth/log-out               controllers.LogOutController.post()


# Institution routes
GET     /institutions               controllers.ListInstitutionsController.get()

GET    /institutions/new            controllers.AddInstitutionController.get()
POST   /institutions/new            controllers.AddInstitutionController.post()

GET    /institutions/:id/rename     controllers.RenameInstitutionController.get(id: Long)
POST   /institutions/:id/rename     controllers.RenameInstitutionController.post(id: Long)

GET    /institutions/:id/archive    controllers.ArchiveInstitutionController.archive(id: Long)  

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
